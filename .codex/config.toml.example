# Copy this file to `.codex/config.toml` and replace `/absolute/path/to/dokploy-management-template`
# with this repository's absolute path.
#
# Keep `.codex/config.toml` local and untracked because it contains machine-specific paths.

[mcp_servers.dokploy-example-org-a]
command = "/absolute/path/to/dokploy-management-template/scripts/mcp-dokploy-org-a.sh"
startup_timeout_sec = 30
tool_timeout_sec = 120
default_tools_approval_mode = "prompt"
enabled = true

[mcp_servers.dokploy-example-org-b]
command = "/absolute/path/to/dokploy-management-template/scripts/mcp-dokploy-org-b.sh"
startup_timeout_sec = 30
tool_timeout_sec = 120
default_tools_approval_mode = "prompt"
enabled = true
