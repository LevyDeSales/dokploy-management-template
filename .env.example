DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_CONTEXTS="org-a org-b"

# Context: org-a
# Store only the raw API key value, without the visible label/prefix.
DOKPLOY_CONTEXT_ORG_A_API_KEY=

# Context: org-b
# Store only the raw API key value, without the visible label/prefix.
DOKPLOY_CONTEXT_ORG_B_API_KEY=

# Optional fallback only if IP allowlist or direct access is not sufficient.
# DOKPLOY_CUSTOM_HEADERS={"Header-Name":"header-value"}
